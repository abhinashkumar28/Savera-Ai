# Savera AI Backend Configuration

# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173,http://localhost:3000
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/savera_ai?schema=public"

# JWT Secret (CHANGE THIS IN PRODUCTION - generate with: openssl rand -base64 32)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# SMS Provider Configuration
# Options: 'demo', 'msg91', 'twilio'
SMS_PROVIDER=demo

# MSG91 Configuration (India-specific DLT compliant)
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_SENDER_ID=SAVERA  # 6-letter registered sender ID
MSG91_TEMPLATE_ID=your_dlt_template_id_here

# Twilio Configuration (Alternative)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Redis (Optional - for caching and rate limiting)
REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=info

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
